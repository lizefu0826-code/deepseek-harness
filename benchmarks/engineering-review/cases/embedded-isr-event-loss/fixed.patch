diff --git a/event_counter.c b/event_counter.c
--- a/event_counter.c
+++ b/event_counter.c
@@ -1,3 +1,14 @@
 #include "event_counter.h"
+#include <stdatomic.h>
-
+
-/* Candidate implementation is applied by the benchmark runner. */
+static _Atomic uint32_t pending_events;
+
+void event_record_from_isr(void)
+{
+  atomic_fetch_add_explicit(&pending_events, 1u, memory_order_relaxed);
+}
+
+uint32_t event_take_all(void)
+{
+  return atomic_exchange_explicit(&pending_events, 0u, memory_order_acq_rel);
+}
