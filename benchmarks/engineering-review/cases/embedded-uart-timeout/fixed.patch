diff --git a/uart_timeout.c b/uart_timeout.c
--- a/uart_timeout.c
+++ b/uart_timeout.c
@@ -1,3 +1,11 @@
 #include "uart_timeout.h"
-
+
-/* Candidate implementation is applied by the benchmark runner. */
+int uart_wait_ready(uart_regs_t *uart, uint32_t start, uint32_t timeout)
+{
+  while ((uart->status & UART_READY) == 0u) {
+    if ((uint32_t)(platform_tick_now() - start) > timeout) {
+      return 1;
+    }
+  }
+  return 0;
+}
