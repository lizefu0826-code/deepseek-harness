diff --git a/dma_sender.c b/dma_sender.c
--- a/dma_sender.c
+++ b/dma_sender.c
@@ -1,3 +1,25 @@
 #include "dma_sender.h"
+#include <stdbool.h>
+#include <string.h>
-
+
-/* Candidate implementation is applied by the benchmark runner. */
+static uint8_t dma_buffer[64];
+static bool dma_in_flight;
+
+int dma_send_frame(const uint8_t *data, size_t length)
+{
+  if (dma_in_flight || length > sizeof(dma_buffer)) {
+    return -1;
+  }
+  memcpy(dma_buffer, data, length);
+  dma_in_flight = true;
+  if (platform_dma_start(dma_buffer, length) != 0) {
+    dma_in_flight = false;
+    return -1;
+  }
+  return 0;
+}
+
+void dma_send_complete(void)
+{
+  dma_in_flight = false;
+}
